# Local Suricata rules for lab validation only.
# Keep these rules simple and clearly labelled.

alert icmp any any -> any any (msg:"LAB ICMP Ping Observed"; sid:1000001; rev:1;)
alert tcp any any -> any 445 (msg:"LAB SMB Connection Attempt"; sid:1000002; rev:1;)
alert tcp any any -> any 3389 (msg:"LAB RDP Connection Attempt"; sid:1000003; rev:1;)
